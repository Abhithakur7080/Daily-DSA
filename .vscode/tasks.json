{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Python File (Daily-DSA)",
            "type": "shell",
            "command": "python",
            "args": [
                "${relativeFile}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
